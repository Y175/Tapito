    "NSMicrophoneUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Use your microphone for a voice conversation you start. End the conversation to stop recording."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在你主动开启连续语音时使用麦克风，结束对话即停止收音。"
          }
        }
      }
